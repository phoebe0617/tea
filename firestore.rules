rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for Product
    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.priceM is number && data.priceM >= 0 &&
             data.priceL is number && data.priceL >= 0 &&
             data.category is string &&
             data.available is bool;
    }

    // Validation for Order
    function isValidOrder(data) {
      return data.total is number && data.total >= 0 &&
             data.status in ['pending', 'preparing', 'completed', 'cancelled'] &&
             data.items is list && data.items.size() > 0 &&
             data.createdAt != null;
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidProduct(incoming());
      allow delete: if true; // In a real app, only admins
    }

    // Orders
    match /orders/{orderId} {
      allow read: if true; // In a real app, only owner or admin
      allow create: if isValidOrder(incoming());
      allow update: if isValidOrder(incoming()) && (
        // Allow status updates
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['status'])
      );
      allow delete: if true;
    }

    // Categories
    match /categories/{catId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
