{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A tea menu item",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "priceM": { "type": "number" },
        "priceL": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "available": { "type": "boolean" }
      },
      "required": ["name", "priceM", "priceL", "category"]
    },
    "Order": {
      "title": "Order",
      "description": "A tea order",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "tableNumber": { "type": "string" },
        "items": { 
          "type": "array",
          "items": { "type": "object" }
        },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "preparing", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["items", "total", "status", "createdAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Menu category",
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      },
      "required": ["name"]
    }
  },
  "firestore": {
    "products": {
      "schema": "Product",
      "description": "Collection of tea products"
    },
    "orders": {
      "schema": "Order",
      "description": "Collection of customer orders"
    },
    "categories": {
      "schema": "Category",
      "description": "Menu categories"
    }
  }
}
